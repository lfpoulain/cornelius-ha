#!/command/with-contenv bashio
# shellcheck shell=bash
# Serveur Cornelius. CORNELIUS_SUPERVISED=1 : un redémarrage demandé par l'administration
# quitte simplement, et s6 relance le serveur.

cd /app || bashio::exit.nok "Cornelius est absent de l'image."
